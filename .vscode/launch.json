{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flutter Web (Chrome)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "-d",
        "chrome"
      ]
    },
    {
      "name": "Flutter Web Server (Port 8080)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "-d",
        "web-server",
        "--web-port",
        "8080"
      ]
    },
    {
      "name": "Flutter Tests",
      "request": "launch",
      "type": "dart",
      "program": "test/widget_test.dart"
    }
  ]
}
